#!/bin/sh
# Tessera's AppImage entry point.
#
# The vendor drivers are not in the AppImage (they cannot be redistributed):
# on the first start, and whenever a new AppImage pins other versions, they
# are downloaded from the vendors, checked against the pinned sha256 and
# unpacked into ~/.local/share/tessera/extra by the same apply_extra.sh the
# Flatpak runs at install time. Then Tessera starts with the driver
# descriptions pointing there.
HERE=$(dirname "$(readlink -f "$0")")
SHARE="$HERE/usr/share/tessera"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/tessera"
EXTRA="$DATA/extra"
PINS="$SHARE/drivers.list"

log() { echo "tessera (AppImage): $*" >&2; }
note() {
    log "$*"
    command -v notify-send >/dev/null 2>&1 &&
        notify-send --app-name=Tessera --icon=dialog-information "Tessera" "$*" 2>/dev/null || true
}

fetch() { # url file
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 3 -A "Mozilla/5.0 (X11; Linux x86_64) Tessera" -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -U "Mozilla/5.0 (X11; Linux x86_64) Tessera" -O "$2" "$1"
    else
        log "neither curl nor wget is installed"
        return 1
    fi
}

if ! cmp -s "$PINS" "$EXTRA/.pins"; then
    note "Baixando os drivers dos fornecedores (primeira execução ou versão nova). Downloading the vendors' drivers…"
    mkdir -p "$DATA"
    tmp=$(mktemp -d "$DATA/.extra-XXXXXX") || exit 1
    ok=1
    while read -r name url sha; do
        case "$name" in ''|'#'*) continue ;; esac
        if ! fetch "$url" "$tmp/$name"; then
            log "could not download $url"
            ok=0
            rm -f "$tmp/$name"
        elif ! echo "$sha  $tmp/$name" | sha256sum -c --quiet - >/dev/null 2>&1; then
            log "$name: sha256 does not match the pinned one; skipped"
            ok=0
            rm -f "$tmp/$name"
        fi
    done < "$PINS"
    if [ $ok = 0 ] && [ -f "$EXTRA/.pins" ]; then
        # A complete older set is kept rather than replaced by an incomplete
        # newer one; the download is tried again on the next start.
        rm -rf "$tmp"
        note "Não foi possível baixar os drivers novos; o Tessera continua com os anteriores e tentará de novo na próxima vez. Could not download the new drivers; keeping the previous ones."
    else
        EXTRA_ROOT="$tmp" APP_EXTRA="$EXTRA" PATH="$HERE/usr/bin:$PATH" sh "$SHARE/apply_extra.sh"
        rm -rf "$EXTRA"
        mv "$tmp" "$EXTRA"
        # Only a complete set is remembered: a failed download is tried
        # again on the next start.
        if [ $ok = 1 ]; then
            cp "$PINS" "$EXTRA/.pins"
            note "Drivers prontos. Drivers ready."
        else
            note "Alguns drivers não puderam ser baixados; o Tessera tentará de novo na próxima vez. Some drivers could not be downloaded."
        fi
    fi
fi

# The driver descriptions, pointing at the unpacked drivers. SerproID's
# OpenSSL needs a CA bundle: Debian's path, or Fedora's.
cabundle=/etc/ssl/certs/ca-certificates.crt
[ -f "$cabundle" ] || cabundle=/etc/pki/tls/certs/ca-bundle.crt
rm -rf "$DATA/drivers"
for f in "$SHARE"/drivers/*/driver.toml; do
    id=$(basename "$(dirname "$f")")
    mkdir -p "$DATA/drivers/$id"
    sed -e "s|/app/extra|$EXTRA|g" -e "s|/etc/ssl/certs/ca-certificates.crt|$cabundle|g" \
        "$f" > "$DATA/drivers/$id/driver.toml"
done
export TESSERA_DRIVERS_PATH="$DATA/drivers"

# The system's p11-kit pieces where they exist (they must match the
# system's p11-kit); the AppImage's own copies otherwise.
if [ -z "${TESSERA_CLIENT_MODULE:-}" ]; then
    for c in /usr/lib64/pkcs11/p11-kit-client.so /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so /usr/lib/pkcs11/p11-kit-client.so "$HERE/usr/lib/p11-kit-client.so"; do
        if [ -f "$c" ]; then export TESSERA_CLIENT_MODULE="$c"; break; fi
    done
fi
if [ -z "${TESSERA_P11KIT_SERVER:-}" ]; then
    found=
    for c in /usr/libexec/p11-kit/p11-kit-server /usr/lib/x86_64-linux-gnu/p11-kit/p11-kit-server /usr/lib/p11-kit/p11-kit-server; do
        [ -x "$c" ] && found=1 && break
    done
    [ -n "$found" ] || export TESSERA_P11KIT_SERVER="$HERE/usr/bin/p11-kit-server"
fi

exec "$HERE/usr/bin/tessera" "$@"
